PORT=3101
APP_ORIGIN=http://127.0.0.1:5174
DATABASE_URL=postgres://postgres:postgres@localhost:5432/house_accounts
SESSION_SECRET=replace-with-at-least-32-random-characters

# Square credentials belong to this service, never to a storefront.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-07-15
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://accounts.example.com/api/webhooks/square
# Must exactly match the free custom payment method configured in Square POS.
SQUARE_INSTITUTIONAL_TENDER_NAMES=Amazing Donuts Account

# Local delivery from 3499 Bathurst St. Amounts are in Canadian cents.
ENABLE_DELIVERY=true
DELIVERY_POSTAL_PREFIXES=M2R,M3H,M3K,M3M,M3N,M4N,M5M,M6A
DELIVERY_MINIMUM_AMOUNT=2500
DELIVERY_FEE_AMOUNT=500
DELIVERY_FREE_THRESHOLD=10000

# Tenant selected when a custom domain does not provide one.
DEFAULT_TENANT_SLUG=amazing-donuts
