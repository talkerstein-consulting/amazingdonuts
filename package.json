{
  "name": "amazing-donuts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:accounts",
    "build:site": "tsc -b && vite build",
    "build:accounts": "vite build --config apps/house-accounts/vite.config.js",
    "accounts:migrate": "node apps/house-accounts/database/migrate.js",
    "accounts:seed": "node apps/house-accounts/database/seed.js",
    "accounts:import-owner": "node apps/house-accounts/database/import-owner.js",
    "test": "node --test apps/house-accounts/test/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.475.0",
    "motion": "^13.1.1",
    "nodemailer": "^9.0.5",
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "terser": "^5.50.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
