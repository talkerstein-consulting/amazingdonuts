# API
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amazing_donuts

# Square. Start with Sandbox credentials from developer.squareup.com/apps.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-07-15
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://example.com/api/webhooks/square

# Checkout behavior
CHECKOUT_REDIRECT_URL=http://localhost:5173/order-confirmation
MERCHANT_SUPPORT_EMAIL=
ADMIN_EMAILS=
SESSION_SECRET=
ALLOW_TIPPING=true
ENABLE_DELIVERY=false
DELIVERY_POSTAL_PREFIXES=M2R,M3H,M3K,M3M,M3N,M4N,M5M,M6A
DELIVERY_MINIMUM_AMOUNT=2500
DELIVERY_FEE_AMOUNT=800
PREP_TIME_MINUTES=30
MIN_ORDER_LEAD_MINUTES=60
MAX_ORDER_ADVANCE_DAYS=30

# House Account ordering remains off until the Phase 0 Square tender tests pass.
ENABLE_HOUSE_ACCOUNTS=false
